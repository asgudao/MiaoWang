<template>
	<view class="rm-page">
		<!-- 头部 -->
		<view class="rm-header">
			<text class="rm-header-title">📅 护理日历</text>
			<text class="rm-header-sub">不再错过每一次呵护</text>
		</view>

		<scroll-view scroll-y="true" class="rm-scroll">
			<view class="rm-pet-section" v-for="pet in pets" :key="pet.id">
				<!-- 宠物头部 -->
				<view class="rm-pet-bar">
					<view class="rm-pet-avatar">
						<text class="rm-pet-icon">{{ pet.species === 1 ? '🐱' : '🐶' }}</text>
					</view>
					<text class="rm-pet-name">{{ pet.name }}</text>
				</view>

				<!-- 提醒列表 -->
				<view class="rm-list">
					<view class="rm-card" v-for="r in pet.reminders" :key="r.id">
						<view class="rm-card-icon" :style="{ backgroundColor: statusBgColor(r.nextDate) }">
							<text>{{ typeEmoji(r.ruleType) }}</text>
						</view>
						<view class="rm-card-mid">
							<text class="rm-card-type">{{ typeLabel(r.ruleType) }}</text>
							<text class="rm-card-date">{{ r.nextDate }}</text>
							<text class="rm-card-cycle">每隔 {{ r.cycleDays }} 天</text>
						</view>
						<view class="rm-card-status" :style="{ backgroundColor: statusColor(r.nextDate) }">
							<text class="rm-status-text">{{ statusText(r.nextDate) }}</text>
						</view>
					</view>
				</view>

				<!-- 添加 -->
				<view class="rm-add-btn" @click="openAdd(pet.id, pet.name)">
					<text class="rm-add-text">＋ 添加提醒</text>
				</view>
			</view>
		</scroll-view>

		<!-- 弹窗 -->
		<view class="rm-modal" v-if="showModal">
			<view class="rm-mask" @click="showModal=false"></view>
			<view class="rm-form">
				<text class="rm-form-title">为 {{ addPetName }} 添加提醒</text>
				<view class="rm-field">
					<text class="rm-label">提醒类型</text>
					<picker :range="typeOptions" @change="onTypePick">
						<view class="rm-picker"><text>{{ typeOptions[addTypeIdx] }}</text></view>
					</picker>
				</view>
				<view class="rm-field">
					<text class="rm-label">日期</text>
					<input class="rm-input" v-model="addDate" placeholder="yyyy-MM-dd" />
				</view>
				<view class="rm-field">
					<text class="rm-label">间隔天数</text>
					<input class="rm-input" v-model="addCycle" type="number" placeholder="如 90" />
				</view>
				<view class="rm-actions">
					<view class="rm-cancel" @click="showModal=false"><text>取消</text></view>
					<view class="rm-confirm" @click="doAdd"><text>确定</text></view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"

type RemData = { id: number; ruleType: string; nextDate: string; cycleDays: number; enabled: boolean }
type PetWithRem = { id: number; name: string; species: number; reminders: RemData[] }

const pets = ref<PetWithRem[]>([])
const typeOptions = ["疫苗", "驱虫", "剪指甲", "洗澡", "体检"]
const typeKeys = ["vaccine", "deworm", "nail", "bath", "checkup"]

const showModal = ref(false)
const addPetId = ref(0)
const addPetName = ref("")
const addTypeIdx = ref(0)
const addDate = ref("")
const addCycle = ref("90")

function getToken(): string {
	const t = uni.getStorageSync("token")
	return t != null ? t as string : ""
}

function parseDate(s: string): number {
	const parts = s.split("-")
	if (parts.length !== 3) return 0
	const y = parseInt(parts[0])
	const m = parseInt(parts[1]) - 1
	const d = parseInt(parts[2])
	return new Date(y, m, d).getTime()
}

function typeEmoji(t: string): string {
	if (t === "vaccine") return "💉"
	if (t === "deworm") return "💊"
	if (t === "nail") return "✂️"
	if (t === "bath") return "🛁"
	if (t === "checkup") return "🏥"
	return "📋"
}

function typeLabel(t: string): string {
	if (t === "vaccine") return "疫苗"
	if (t === "deworm") return "驱虫"
	if (t === "nail") return "剪指甲"
	if (t === "bath") return "洗澡"
	if (t === "checkup") return "体检"
	return t
}

function statusColor(dateStr: string): string {
	const d = parseDate(dateStr)
	const now = Date.now()
	const diff = d - now
	const dayMs: number = 86400000
	if (diff < 0) return "#FFE0E0"
	if (diff < 3 * dayMs) return "#FFF0E0"
	if (diff < 7 * dayMs) return "#FFF8E0"
	return "#E8F6E8"
}

function statusBgColor(dateStr: string): string {
	const d = parseDate(dateStr)
	const now = Date.now()
	const diff = d - now
	const dayMs: number = 86400000
	if (diff < 0) return "#FFF0F0"
	if (diff < 3 * dayMs) return "#FFF5EC"
	if (diff < 7 * dayMs) return "#FFFBE8"
	return "#F0FAF0"
}

function statusText(dateStr: string): string {
	const d = parseDate(dateStr)
	const now = Date.now()
	const diff = d - now
	const dayMs: number = 86400000
	if (diff < 0) return "已过期"
	if (diff < dayMs) return "今天"
	if (diff < 2 * dayMs) return "明天"
	if (diff < 7 * dayMs) {
		const days: number = Math.ceil(diff / dayMs)
		return days + "天后"
	}
	return "还早"
}

function loadReminders(petId: number, idx: number): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/reminders?petId=" + petId,
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) {
						const arr = inner as any as any[]
						const rems: RemData[] = []
						for (let k = 0; k < arr.length; k++) {
							const r = arr[k] as UTSJSONObject
							const rid = r.getNumber("id")
							const rtype = r.getString("ruleType")
							const rdate = r.getString("nextDate")
							const rcycle = r.getNumber("cycleDays")
							rems.push({
								id: rid != null ? rid : 0,
								ruleType: rtype != null ? rtype : "",
								nextDate: rdate != null ? rdate : "",
								cycleDays: rcycle != null ? rcycle : 0,
								enabled: true
							})
						}
						if (idx < pets.value.length) {
							const updated = pets.value
							updated[idx].reminders = rems
							pets.value = updated
						}
					}
				}
			}
		},
		fail: (): void => {}
	})
}

function loadData(): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/pets?userId=1",
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) {
						const petList = inner as any as any[]
						const result: PetWithRem[] = []
						for (let i = 0; i < petList.length; i++) {
							const p = petList[i] as UTSJSONObject
							const pid = p.getNumber("id")
							const pname = p.getString("name")
							const pspecies = p.getNumber("species")
							result.push({
								id: pid != null ? pid : 0,
								name: pname != null ? pname : "",
								species: pspecies != null ? pspecies : 1,
								reminders: []
							})
						}
						pets.value = result
						for (let j = 0; j < result.length; j++) {
							loadReminders(result[j].id, j)
						}
					}
				}
			}
		},
		fail: (): void => {}
	})
}

function openAdd(petId: number, petName: string): void {
	addPetId.value = petId
	addPetName.value = petName
	addTypeIdx.value = 0
	addDate.value = ""
	addCycle.value = "90"
	showModal.value = true
}

function onTypePick(e: UTSJSONObject): void {
	const detail = e.get("detail") as UTSJSONObject
	const v = detail.getNumber("value")
	if (v != null) addTypeIdx.value = v
}

function doAdd(): void {
	if (addDate.value === "") { uni.showToast({ title: "请输入日期", icon: "none" }); return }
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token

	const body = new UTSJSONObject()
	body["petId"] = addPetId.value
	body["ruleType"] = typeKeys[addTypeIdx.value]
	body["nextDate"] = addDate.value
	body["cycleDays"] = parseInt(addCycle.value)
	body["enabled"] = true

	uni.request({
		url: BASE + "/api/reminders",
		method: "POST",
		data: body,
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const resp = d as UTSJSONObject
				const code = resp.getNumber("code")
				if (code === 200) {
					uni.showToast({ title: "添加成功", icon: "success" })
					showModal.value = false
					loadData()
				} else {
					uni.showToast({ title: "添加失败", icon: "none" })
				}
			}
		},
		fail: (): void => { uni.showToast({ title: "网络错误", icon: "none" }) }
	})
}

onShow(() => { loadData() })
</script>

<style>
.rm-page {
	padding-top: 30rpx;
	flex: 1;
	flex-direction: column;
	background-color: #FFF5EC;
}

/* -- 头部 -- */
.rm-header {
	padding: 48rpx 32rpx 12rpx;
}
.rm-header-title {
	font-size: 38rpx;
	font-weight: 800;
	color: #3D2C2A;
}
.rm-header-sub {
	font-size: 24rpx;
	color: #B8A098;
	margin-top: 6rpx;
}

/* -- 滚动区 -- */
.rm-scroll {
	flex: 1;
	padding: 8rpx 28rpx;
}

/* -- 宠物区块 -- */
.rm-pet-section {
	margin-bottom: 32rpx;
}
.rm-pet-bar {
	flex-direction: row;
	align-items: center;
	margin-bottom: 14rpx;
}
.rm-pet-avatar {
	width: 64rpx;
	height: 64rpx;
	border-radius: 32rpx;
	background-color: #FFF0E5;
	align-items: center;
	justify-content: center;
	margin-right: 16rpx;
}
.rm-pet-icon {
	font-size: 36rpx;
}
.rm-pet-name {
	font-size: 32rpx;
	font-weight: 700;
	color: #3D2C2A;
}

/* -- 提醒卡片 -- */
.rm-card {
	flex-direction: row;
	align-items: center;
	margin-bottom: 10rpx;
	padding: 22rpx 24rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
}
.rm-card-icon {
	width: 80rpx;
	height: 80rpx;
	border-radius: 18rpx;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
	font-size: 36rpx;
}
.rm-card-mid {
	flex: 1;
	flex-direction: column;
}
.rm-card-type {
	font-size: 28rpx;
	font-weight: 700;
	color: #3D2C2A;
}
.rm-card-date {
	font-size: 24rpx;
	color: #8C7A70;
	margin-top: 4rpx;
}
.rm-card-cycle {
	font-size: 22rpx;
	color: #B8A098;
	margin-top: 2rpx;
}
.rm-card-status {
	padding: 8rpx 20rpx;
	border-radius: 24rpx;
}
.rm-status-text {
	font-size: 22rpx;
	font-weight: 700;
	color: #8C7A70;
}

/* -- 添加按钮 -- */
.rm-add-btn {
	padding: 18rpx 0;
	border-radius: 40rpx;
	border: 2rpx dashed #FFD4B8;
	align-items: center;
	margin-top: 8rpx;
}
.rm-add-text {
	font-size: 24rpx;
	color: #FF8C42;
	font-weight: 600;
}

/* -- 弹窗 -- */
.rm-modal {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	align-items: center;
	justify-content: center;
}
.rm-mask {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0,0,0,0.35);
}
.rm-form {
	width: 600rpx;
	padding: 40rpx 36rpx;
	background-color: #FFFFFF;
	border-radius: 28rpx;
}
.rm-form-title {
	font-size: 32rpx;
	font-weight: 700;
	color: #3D2C2A;
	margin-bottom: 32rpx;
	text-align: center;
}
.rm-field {
	margin-bottom: 22rpx;
}
.rm-label {
	font-size: 26rpx;
	color: #8C7A70;
	margin-bottom: 10rpx;
	font-weight: 600;
}
.rm-input {
	height: 80rpx;
	padding: 0 22rpx;
	background-color: #FFF8F2;
	border-radius: 16rpx;
	font-size: 28rpx;
	color: #3D2C2A;
	border: 2rpx solid #FFE8D6;
}
.rm-picker {
	height: 80rpx;
	padding: 0 22rpx;
	background-color: #FFF8F2;
	border-radius: 16rpx;
	justify-content: center;
	font-size: 28rpx;
	color: #3D2C2A;
	border: 2rpx solid #FFE8D6;
}
.rm-actions {
	flex-direction: row;
	margin-top: 32rpx;
}
.rm-cancel {
	flex: 1;
	height: 80rpx;
	background-color: #F5F0EC;
	border-radius: 40rpx;
	align-items: center;
	justify-content: center;
	margin-right: 16rpx;
	font-size: 28rpx;
	color: #8C7A70;
	font-weight: 600;
}
.rm-confirm {
	flex: 1;
	height: 80rpx;
	background-color: #FF8C42;
	border-radius: 40rpx;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	color: #FFFFFF;
	font-weight: 700;
}
</style>