<template>
	<view class="fv-page">
		<!-- 头部 -->
		<view class="fv-header">
			<text class="fv-header-icon">⭐</text>
			<text class="fv-header-title">我的收藏</text>
		</view>

		<!-- 空状态 -->
		<view class="fv-empty" v-if="favList.length === 0">
			<text class="fv-empty-icon">🔖</text>
			<text class="fv-empty-title">还没有收藏</text>
			<text class="fv-empty-desc">在知识库文章详情页可以收藏哦</text>
		</view>

		<!-- 收藏列表 -->
		<scroll-view scroll-y="true" class="fv-scroll" v-if="favList.length > 0">
			<view class="fv-item" v-for="item in favList" :key="item.id" @click="goDetail(item.id)">
				<view class="fv-item-cover">
					<text>📖</text>
				</view>
				<view class="fv-item-info">
					<text class="fv-item-title">{{ item.title }}</text>
					<text class="fv-item-time">{{ item.time }}</text>
				</view>
				<view class="fv-item-del" @click.stop="removeFav(item.id)">
					<text class="fv-item-del-icon">✕</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
type FavItem = { id: number; title: string; time: string }

const favList = ref<FavItem[]>([])

function loadFavs(): void {
	const raw = uni.getStorageSync("favorites")
	if (raw != null && raw !== "") {
		const arr = JSON.parse(raw as string) as any[]
		const result: FavItem[] = []
		for (let i = 0; i < arr.length; i++) {
			const item = arr[i] as UTSJSONObject
			const nid = item.getNumber("id")
			const ntitle = item.getString("title")
			const ntime = item.getString("time")
			result.push({
				id: nid != null ? nid : 0,
				title: ntitle != null ? ntitle : "",
				time: ntime != null ? ntime : ""
			})
		}
		favList.value = result
	} else {
		favList.value = []
	}
}

function removeFav(id: number): void {
	const raw = uni.getStorageSync("favorites")
	if (raw != null && raw !== "") {
		const arr = JSON.parse(raw as string) as any[]
		const filtered: any[] = []
		for (let i = 0; i < arr.length; i++) {
			const item = arr[i] as UTSJSONObject
			const nid = item.getNumber("id")
			if (nid != null && nid !== id) filtered.push(item)
		}
		uni.setStorageSync("favorites", JSON.stringify(filtered))
	}
	loadFavs()
	uni.showToast({ title: "已取消收藏", icon: "none" })
}

function goDetail(id: number): void {
	uni.navigateTo({ url: "/pages/knowledge/detail?id=" + id })
}

onShow(() => { loadFavs() })
</script>

<style>
.fv-page {
	flex: 1;
	flex-direction: column;
	background-color: #FFF5EC;
}

/* -- 头部 -- */
.fv-header {
	flex-direction: row;
	align-items: center;
	padding: 48rpx 32rpx 16rpx;
}
.fv-header-icon {
	font-size: 40rpx;
	margin-right: 16rpx;
}
.fv-header-title {
	font-size: 38rpx;
	font-weight: 800;
	color: #3D2C2A;
}

/* -- 空状态 -- */
.fv-empty {
	flex: 1;
	align-items: center;
	justify-content: center;
	padding-bottom: 120rpx;
}
.fv-empty-icon {
	font-size: 100rpx;
	margin-bottom: 20rpx;
}
.fv-empty-title {
	font-size: 32rpx;
	font-weight: 700;
	color: #5C4033;
	margin-bottom: 10rpx;
}
.fv-empty-desc {
	font-size: 26rpx;
	color: #B8A098;
}

/* -- 列表 -- */
.fv-scroll {
	flex: 1;
	padding: 8rpx 28rpx;
}
.fv-item {
	flex-direction: row;
	align-items: center;
	margin-bottom: 14rpx;
	padding: 24rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
}
.fv-item-cover {
	width: 96rpx;
	height: 96rpx;
	border-radius: 18rpx;
	background-color: #FFF0E5;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
	font-size: 44rpx;
}
.fv-item-info {
	flex: 1;
	flex-direction: column;
}
.fv-item-title {
	font-size: 28rpx;
	font-weight: 700;
	color: #3D2C2A;
}
.fv-item-time {
	font-size: 22rpx;
	color: #B8A098;
	margin-top: 8rpx;
}
.fv-item-del {
	width: 56rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #FFF0F0;
	align-items: center;
	justify-content: center;
}
.fv-item-del-icon {
	font-size: 26rpx;
	color: #E88888;
	font-weight: 700;
}
</style>