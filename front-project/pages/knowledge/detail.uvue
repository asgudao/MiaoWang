<template>
	<view class="kd-page">
		<scroll-view scroll-y="true" class="kd-scroll">
			<view class="kd-cover"></view>
			<view class="kd-body">
				<view class="kd-title-row">
					<text class="kd-title">{{ detail.title }}</text>
					<view class="kd-fav" @click="toggleFav">
						<text class="kd-fav-text">{{ isFaved ? "★" : "☆" }}</text>
					</view>
				</view>
				<view class="kd-meta"><text class="kd-meta-text">{{ detail.viewCount }} 次浏览</text></view>
				<text class="kd-content">{{ detail.content }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"

type DetailData = { id: number; title: string; content: string; viewCount: number }

const detail = ref<DetailData>({ id: 0, title: "加载中...", content: "", viewCount: 0 })
const isFaved = ref(false)

function getToken(): string {
	const t = uni.getStorageSync("token")
	return t != null ? t as string : ""
}

function checkFav(): void {
	const raw = uni.getStorageSync("favorites")
	if (raw == null || raw === "") { isFaved.value = false; return }
	const arr = JSON.parse(raw as string) as any[]
	let found = false
	for (let i = 0; i < arr.length; i++) {
		const item = arr[i] as UTSJSONObject
		const nid = item.getNumber("id")
		if (nid != null && nid === detail.value.id) { found = true; break }
	}
	isFaved.value = found
}

function fetchDetail(id: number): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/knowledge/" + id,
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) {
						detail.value = inner as any as DetailData
						checkFav()
					}
				}
			}
		},
		fail: (): void => {}
	})
}

function toggleFav(): void {
	const raw = uni.getStorageSync("favorites")
	let arr: any[] = []
	if (raw != null && raw !== "") arr = JSON.parse(raw as string) as any[]

	if (isFaved.value) {
		const filtered: any[] = []
		for (let i = 0; i < arr.length; i++) {
			const item = arr[i] as UTSJSONObject
			const nid = item.getNumber("id")
			if (nid != null && nid !== detail.value.id) filtered.push(item)
		}
		uni.setStorageSync("favorites", JSON.stringify(filtered))
		isFaved.value = false
		uni.showToast({ title: "已取消收藏", icon: "none" })
	} else {
		const newItem = new UTSJSONObject()
		newItem["id"] = detail.value.id
		newItem["title"] = detail.value.title
		const now = new Date()
		newItem["time"] = now.getFullYear() + "-" + (now.getMonth()+1) + "-" + now.getDate()
		arr.push(newItem)
		uni.setStorageSync("favorites", JSON.stringify(arr))
		isFaved.value = true
		uni.showToast({ title: "已收藏", icon: "success" })
	}
}

onLoad((opt) => {
	const id = opt?.["id"]
	if (id) fetchDetail(parseInt(id as string))
})
</script>

<style>
.kd-page {
	padding-top: 30rpx; background-color: #FFF; flex: 1; flex-direction: column; }
.kd-scroll { flex: 1; }
.kd-cover { height: 360rpx; background-color: #FFE0CC; }
.kd-body { padding: 28rpx; }
.kd-title-row { flex-direction: row; justify-content: space-between; align-items: center; }
.kd-title { font-size: 34rpx; font-weight: 700; color: #333; flex: 1; }
.kd-fav { width: 56rpx; height: 56rpx; align-items: center; justify-content: center; }
.kd-fav-text { font-size: 40rpx; color: #FF8C42; }
.kd-meta { margin: 12rpx 0 24rpx; }
.kd-meta-text { font-size: 24rpx; color: #999; }
.kd-content { font-size: 30rpx; color: #444; }
</style>