}

/* -- 文章列表 -- */
.kw-list {
	flex: 1;
	padding: 12rpx 28rpx;
}
.kw-item {
	flex-direction: row;
	align-items: center;
	margin-bottom: 14rpx;
	padding: 24rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
}
.kw-item-cover {
	width: 116rpx;
	height: 116rpx;
	border-radius: 18rpx;
	background-color: #FFF0E5;
	align-items: center;
	justify-content: center;
	margin-right: 22rpx;
}
.kw-cover-emoji {
	font-size: 56rpx;
}
.kw-item-body {
	flex: 1;
	flex-direction: column;
	justify-content: space-between;
}
.kw-item-title {
	font-size: 30rpx;
	font-weight: 700;
	color: #3D2C2A;
	line-height: 42rpx;
}
.kw-item-footer {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-top: 16rpx;
}
.kw-item-views {
	font-size: 22rpx;
	color: #B8A098;
}
.kw-item-arrow {
