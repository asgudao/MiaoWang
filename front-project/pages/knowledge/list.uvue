.kw-species-bar {
	flex-direction: row;
	padding: 0 28rpx 20rpx;
}
.kw-species-item {
	flex: 1;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 80rpx;
	border-radius: 40rpx;
	background-color: #FFFFFF;
	margin-right: 16rpx;
}
.kw-species-on {
	background-color: #FF8C42;
}
.kw-species-emoji {
	font-size: 36rpx;
	margin-right: 10rpx;
}
.kw-species-label {
	font-size: 28rpx;
	font-weight: 700;
	color: #5C4033;
}
