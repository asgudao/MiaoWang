	padding-top: 30rpx;
	flex: 1;
	flex-direction: column;
	background-color: #FFF5EC;
}

/* -- 头部 -- */
.kw-header {
	padding: 48rpx 32rpx 12rpx;
}
.kw-header-title {
	font-size: 38rpx;
	font-weight: 800;
	color: #3D2C2A;
}
