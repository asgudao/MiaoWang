<template>
	<view class="kw-page">
		<!-- 头部 -->
		<view class="kw-header">
			<text class="kw-header-title">📚 养宠知识</text>
			<text class="kw-header-sub">学会更多，更懂它</text>
		</view>

		<!-- 物种切换 -->
		<view class="kw-species-bar">
			<view class="kw-species-item" :class="activeSpecies===1?'kw-species-on':''" @click="switchSpecies(1)">
				<text class="kw-species-emoji">🐱</text>
				<text class="kw-species-label">猫咪</text>
			</view>
			<view class="kw-species-item" :class="activeSpecies===2?'kw-species-on':''" @click="switchSpecies(2)">
				<text class="kw-species-emoji">🐶</text>
				<text class="kw-species-label">狗狗</text>
			</view>
		</view>

		<!-- 搜索 -->
		<view class="kw-search-wrap">
			<text class="kw-search-icon">🔍</text>
			<input class="kw-search" v-model="keyword" placeholder="搜索养宠知识..." @confirm="doSearch" />
		</view>

		<!-- 分类标签 -->
		<scroll-view scroll-x="true" class="kw-cats" v-if="categories.length > 0">
			<view class="kw-cats-inner">
				<view class="kw-tag" :class="activeCategory===0?'kw-tag-on':''" @click="selectCategory(0)">
					<text class="kw-tag-text">全部</text>
				</view>
				<view class="kw-tag" v-for="cat in categories" :key="cat.id" :class="activeCategory===cat.id?'kw-tag-on':''" @click="selectCategory(cat.id)">
					<text class="kw-tag-text">{{ cat.name }}</text>
				</view>
			</view>
		</scroll-view>

		<!-- 空状态 -->
		<view class="kw-empty" v-if="list.length === 0">
			<text class="kw-empty-icon">📖</text>
			<text class="kw-empty-text">暂无内容</text>
		</view>

		<!-- 文章列表 -->
		<scroll-view scroll-y="true" class="kw-list" v-if="list.length > 0">
			<view class="kw-item" v-for="item in list" :key="item.id" @click="goDetail(item.id)">
				<view class="kw-item-cover">
					<text class="kw-cover-emoji">{{ activeSpecies === 1 ? '🐱' : '🐶' }}</text>
				</view>
				<view class="kw-item-body">
					<text class="kw-item-title">{{ item.title }}</text>
					<view class="kw-item-footer">
						<text class="kw-item-views">👁 {{ item.viewCount }} 次浏览</text>
						<text class="kw-item-arrow">查看 →</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"
type KI = { id: number; title: string; viewCount: number }
type CT = { id: number; name: string; species: number }

const keyword = ref("")
const activeSpecies = ref(1)
const activeCategory = ref(0)
const categories = ref<CT[]>([])
const list = ref<KI[]>([])

function getToken(): string {
	const t = uni.getStorageSync("token")
	return t != null ? t as string : ""
}

function doRequest(url: string, onOk: (data: any) => void): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + url,
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) onOk(inner as any)
				}
			}
		},
		fail: (): void => {}
	})
}

function loadCats(): void {
	doRequest("/api/knowledge/categories?species=" + activeSpecies.value, (data: any): void => {
		const arr = data as any as any[]
		const result: CT[] = []
		for (let i = 0; i < arr.length; i++) {
			const item = arr[i] as UTSJSONObject
			const cid = item.getNumber("id")
			const cname = item.getString("name")
			const cspecies = item.getNumber("species")
			result.push({ id: cid != null ? cid : 0, name: cname != null ? cname : "", species: cspecies != null ? cspecies : 0 } as CT)
		}
		categories.value = result
	})
}

function loadList(): void {
	let url = "/api/knowledge?page=1&size=20"
	if (activeCategory.value > 0) {
		url += "&categoryId=" + activeCategory.value
	} else {
		url += "&species=" + activeSpecies.value
	}
	doRequest(url, (data: any): void => {
		const records = (data as UTSJSONObject).get("records")
		if (records != null) {
			const arr = records as any as any[]
			const result: KI[] = []
			for (let i = 0; i < arr.length; i++) {
				const item = arr[i] as UTSJSONObject
				const kid = item.getNumber("id")
				const ktitle = item.getString("title")
				const kviews = item.getNumber("viewCount")
				result.push({ id: kid != null ? kid : 0, title: ktitle != null ? ktitle : "", viewCount: kviews != null ? kviews : 0 } as KI)
			}
			list.value = result
		}
	})
}

function switchSpecies(s: number): void {
	activeSpecies.value = s
	activeCategory.value = 0
	loadCats()
	loadList()
}

function selectCategory(id: number): void {
	activeCategory.value = id
	loadList()
}

function doSearch(): void {
	doRequest("/api/knowledge/search?keyword=" + keyword.value + "&page=1&size=20", (data: any): void => {
		const records = (data as UTSJSONObject).get("records")
		if (records != null) {
			const arr = records as any as any[]
			const result: KI[] = []
			for (let i = 0; i < arr.length; i++) {
				const item = arr[i] as UTSJSONObject
				const kid = item.getNumber("id")
				const ktitle = item.getString("title")
				const kviews = item.getNumber("viewCount")
				result.push({ id: kid != null ? kid : 0, title: ktitle != null ? ktitle : "", viewCount: kviews != null ? kviews : 0 } as KI)
			}
			list.value = result
		}
	})
}

function goDetail(id: number): void {
	uni.navigateTo({ url: "/pages/knowledge/detail?id=" + id })
}

onShow(() => { loadCats(); loadList() })
</script>

<style>
