	color: #FFFFFF;
}

/* -- 搜索 -- */
.kw-search-wrap {
	flex-direction: row;
	align-items: center;
	height: 80rpx;
	margin: 0 28rpx 16rpx;
	padding: 0 24rpx;
	background-color: #FFFFFF;
	border-radius: 40rpx;
}
.kw-search-icon {
	font-size: 30rpx;
	margin-right: 12rpx;
}
.kw-search {
	flex: 1;
	height: 80rpx;
	font-size: 28rpx;
	color: #3D2C2A;
}

/* -- 分类标签 -- */
.kw-cats {
	height: 64rpx;
	padding-left: 28rpx;
}
.kw-cats-inner {
	flex-direction: row;
}
.kw-tag {
	padding: 10rpx 28rpx;
	margin-right: 12rpx;
	border-radius: 32rpx;
	background-color: #FFFFFF;
}
.kw-tag-on {
	background-color: #FFF0E5;
}
.kw-tag-text {
	font-size: 24rpx;
