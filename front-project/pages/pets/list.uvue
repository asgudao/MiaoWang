<template>
	<view class="pl-page">
		<!-- 顶部 -->
		<view class="pl-header">
			<view class="pl-header-left">
				<text class="pl-header-emoji">🐾</text>
				<text class="pl-header-title">我的萌宠</text>
			</view>
			<text class="pl-header-count" v-if="pets.length > 0">{{ pets.length }} 只小伙伴</text>
		</view>

		<!-- 空状态 -->
		<view class="pl-empty" v-if="pets.length === 0">
			<text class="pl-empty-emoji">🐱</text>
			<text class="pl-empty-title">还没有添加萌宠</text>
			<text class="pl-empty-desc">点击下方按钮，添加你的第一个小伙伴吧</text>
		</view>

		<!-- 宠物列表 -->
		<scroll-view scroll-y="true" class="pl-list" v-if="pets.length > 0">
			<view class="pl-card" v-for="pet in pets" :key="pet.id">
				<view class="pl-card-left">
					<view class="pl-avatar-wrap">
						<text class="pl-avatar">{{ pet.breedName !== "" && pet.breedName.includes("猫") ? "🐱" : "🐶" }}</text>
					</view>
					<view class="pl-info">
						<text class="pl-name">{{ pet.name }}</text>
						<view class="pl-tags">
							<text class="pl-breed-tag">{{ pet.breedName !== "" ? pet.breedName : "未知品种" }}</text>
							<text class="pl-gender-tag">{{ pet.gender === 1 ? "♂ 公" : "♀ 母" }}</text>
						</view>
					</view>
				</view>
				<view class="pl-card-right">
					<view class="pl-stat">
						<text class="pl-stat-val">{{ pet.age }}</text>
						<text class="pl-stat-label">岁</text>
					</view>
					<view class="pl-stat">
						<text class="pl-stat-val">{{ pet.weight }}</text>
						<text class="pl-stat-label">kg</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 添加按钮 -->
		<view class="pl-add" @click="addPet">
			<text class="pl-add-icon">＋</text>
			<text class="pl-add-text">添加宠物</text>
		</view>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"

type PetData = { id: number; name: string; breedName: string; gender: number; age: number; weight: number }

const pets = ref<PetData[]>([])

function getToken(): string {
	const token = uni.getStorageSync("token")
	return token != null ? token as string : ""
}

function loadPets(): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/pets",
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) pets.value = inner as any as PetData[]
				}
			}
		},
		fail: (): void => {}
	})
}

function addPet(): void {
	uni.navigateTo({ url: "/pages/pets/add" })
}

onShow(() => { loadPets() })
</script>

