<template>
	<view class="page-wrap">
		<!-- 个人卡片 -->
		<view class="my-profile">
			<view class="my-avatar">
				<text class="my-avatar-text">🐱</text>
			</view>
			<view class="my-profile-info">
				<text class="my-nickname">{{ user.nickname !== "" ? user.nickname : "猫咕爱好者" }}</text>
				<text class="my-phone">{{ phoneNum }}</text>
				<view class="my-badge" :style="{ backgroundColor: user.memberType === 2 ? '#FFE0B0' : '#F0ECEA' }">
					<text class="my-badge-text" :style="{ color: user.memberType === 2 ? '#C77A20' : '#9C9088' }">
						{{ user.memberType === 2 ? '👑 VIP' : '普通用户' }}
					</text>
				</view>
			</view>
		</view>

		<!-- 会员卡 -->
		<view class="my-member-card" @click="goSubscribe">
			<view class="my-member-left">
				<text class="my-member-icon">⭐</text>
				<view class="my-member-info">
					<text class="my-member-title">会员中心</text>
					<text class="my-member-desc">{{ user.memberType === 2 ? '已享专属特权' : '升级解锁更多萌宠' }}</text>
				</view>
			</view>
			<view class="my-member-action">
				<text class="my-member-action-text">{{ user.memberType === 2 ? '管理' : '升级' }}</text>
			</view>
		</view>

		<!-- 菜单 -->
		<view class="my-menu">
			<view class="my-menu-item" @click="goMyPets">
				<text class="my-menu-icon">🐾</text>
				<text class="my-menu-text">我的萌宠</text>
				<text class="my-menu-arrow">›</text>
			</view>
			<view class="my-menu-item" @click="goReminder">
				<text class="my-menu-icon">📅</text>
				<text class="my-menu-text">护理日历</text>
				<text class="my-menu-arrow">›</text>
			</view>
			<view class="my-menu-item" @click="goFavorites">
				<text class="my-menu-icon">⭐</text>
				<text class="my-menu-text">我的收藏</text>
				<text class="my-menu-arrow">›</text>
			</view>
			<view class="my-menu-item my-menu-last" @click="goAbout">
				<text class="my-menu-icon">ℹ️</text>
				<text class="my-menu-text">关于喵汪</text>
				<text class="my-menu-arrow">›</text>
			</view>
		</view>

		<!-- 退出 -->
		<view class="my-logout" @click="doLogout">
			<text class="my-logout-text">退出登录</text>
		</view>

		<text class="my-footer">喵汪 v1.0 · 用爱陪伴每个毛孩子</text>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"

type UserData = { id: number; nickname: string; memberType: number }

const user = ref<UserData>({ id: 0, nickname: "", memberType: 0 })
const phoneNum = ref("")

function getToken(): string {
	const t = uni.getStorageSync("token")
	return t != null ? t as string : ""
}

function loadProfile(): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/user/profile",
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) {
						const obj = inner as UTSJSONObject
						const uid = obj.getNumber("id")
						const unick = obj.getString("nickname")
						const umember = obj.getNumber("memberType")
						user.value = {
							id: uid != null ? uid : 0,
							nickname: unick != null ? unick : "",
							memberType: umember != null ? umember : 0
						} as UserData
					}
				}
			}
		},
		fail: (): void => {}
	})
}

function goMyPets(): void { uni.switchTab({ url: "/pages/pets/list" }) }
function goReminder(): void { uni.navigateTo({ url: "/pages/reminder/index" }) }
function goFavorites(): void { uni.navigateTo({ url: "/pages/favorites/index" }) }
function goAbout(): void { uni.navigateTo({ url: "/pages/about/index" }) }
function goSubscribe(): void { uni.navigateTo({ url: "/pages/subscription/index" }) }

function doLogout(): void {
	uni.removeStorageSync("token")
	uni.removeStorageSync("phone")
	uni.reLaunch({ url: "/pages/auth/login" })
}

onShow(() => {
	loadProfile()
	const p = uni.getStorageSync("phone")
	phoneNum.value = p != null ? p as string : ""
})
</script>

<style>
.page-wrap {
	padding-top: 50rpx;
	flex: 1;
	flex-direction: column;
	background-color: #FFF5EC;
}

/* -- 个人信息卡 -- */
.my-profile {
	flex-direction: row;
	align-items: center;
	margin: 24rpx 28rpx;
	padding: 36rpx 32rpx;
	background-color: #FF8C42;
	border-radius: 24rpx;
}
.my-avatar {
	width: 112rpx;
	height: 112rpx;
	border-radius: 56rpx;
	background-color: rgba(255,255,255,0.25);
	align-items: center;
	justify-content: center;
	margin-right: 28rpx;
}
