	font-size: 38rpx;
	font-weight: 800;
	color: #FFFFFF;
}
.my-phone {
	font-size: 24rpx;
	color: rgba(255,255,255,0.75);
	margin: 6rpx 0 10rpx;
}
.my-badge {
	padding: 6rpx 22rpx;
	border-radius: 24rpx;
	align-self: flex-start;
}
.my-badge-text {
	font-size: 22rpx;
	font-weight: 700;
}

/* -- 会员卡 -- */
.my-member-card {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 0 28rpx 20rpx;
	padding: 28rpx;
	background-color: #FFFFFF;
	border-radius: 22rpx;
}
.my-member-left {
	flex-direction: row;
	align-items: center;
}
.my-member-icon {
	font-size: 44rpx;
	margin-right: 18rpx;
}
.my-member-info {
	flex-direction: column;
}
.my-member-title {
	font-size: 30rpx;
	font-weight: 700;
	color: #3D2C2A;
}
.my-member-desc {
	font-size: 24rpx;
	color: #B8A098;
	margin-top: 4rpx;
}
.my-member-action {
	padding: 12rpx 28rpx;
	background-color: #FFF0E5;
	border-radius: 36rpx;
}
.my-member-action-text {
	font-size: 26rpx;
	color: #FF8C42;
	font-weight: 700;
}

/* -- 菜单 -- */
.my-menu {
	margin: 0 28rpx;
	background-color: #FFFFFF;
	border-radius: 22rpx;
}
.my-menu-item {
	flex-direction: row;
	align-items: center;
	padding: 30rpx 28rpx;
	border-bottom: 1rpx solid #F5F0EC;
}
.my-menu-last {
	border-bottom: 0;
}
.my-menu-icon {
	font-size: 36rpx;
	margin-right: 20rpx;
}
.my-menu-text {
	flex: 1;
	font-size: 30rpx;
	color: #3D2C2A;
	font-weight: 600;
}
