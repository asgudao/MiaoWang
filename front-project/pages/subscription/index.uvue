<template>
	<view class="sp-page">
		<!-- 头部 -->
		<view class="sp-hero">
			<text class="sp-hero-emoji">👑</text>
			<text class="sp-hero-title">升级会员</text>
			<text class="sp-hero-sub">解锁更多萌宠，享受完整养护体验</text>
		</view>

		<!-- 套餐卡片 -->
		<view class="sp-plans">
			<view class="sp-card" v-for="p in plans" :key="p.id"
				:class="selectedPlanId===p.id?'sp-card-on':''"
				@click="selectPlan(p.id)">
				<!-- 推荐标签 -->
				<view class="sp-recommend" v-if="p.id === plans[plans.length-1]?.id">
					<text class="sp-recommend-text">推荐</text>
				</view>

				<text class="sp-name">{{ p.name }}</text>
				<view class="sp-price-row">
					<text class="sp-price-symbol">¥</text>
					<text class="sp-price">{{ (p.price / 100).toFixed(0) }}</text>
				</view>
				<text class="sp-dur">{{ p.durationDays }} 天 · {{ p.petLimit }} 只萌宠</text>

				<!-- 权益列表 -->
				<view class="sp-features">
					<view class="sp-feature">
						<text class="sp-feature-check">✓</text>
						<text class="sp-feature-text">最多 {{ p.petLimit }} 只宠物</text>
					</view>
					<view class="sp-feature">
						<text class="sp-feature-check">✓</text>
						<text class="sp-feature-text">完整知识库</text>
					</view>
					<view class="sp-feature">
						<text class="sp-feature-check">✓</text>
						<text class="sp-feature-text">护理提醒推送</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 购买按钮 -->
		<view class="sp-buy" @click="buyNow">
			<text class="sp-buy-text">立即购买</text>
		</view>

		<text class="sp-footer">已订阅用户可在会员中心管理</text>
	</view>
</template>

<script setup lang="uts">
const BASE = "http://192.168.178.183:8080"

type PlanData = { id: number; name: string; price: number; durationDays: number; petLimit: number }

const plans = ref<PlanData[]>([])
const selectedPlanId = ref(0)

function getToken(): string {
	const t = uni.getStorageSync("token")
	return t != null ? t as string : ""
}

function loadPlans(): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/subscription/plans",
		method: "GET",
		header: h,
		success: (res): void => {
			const d = res.data
			if (d != null) {
				const body = d as UTSJSONObject
				const code = body.getNumber("code")
				if (code === 200) {
					const inner = body.get("data")
					if (inner != null) {
						const arr = inner as any as PlanData[]
						plans.value = arr
						if (arr.length >= 2) selectedPlanId.value = arr[1].id
						else if (arr.length >= 1) selectedPlanId.value = arr[0].id
					}
				}
			}
		},
		fail: (): void => {}
	})
}

function selectPlan(id: number): void { selectedPlanId.value = id }

function buyNow(): void {
	const token = getToken()
	const h = new UTSJSONObject()
	h["Content-Type"] = "application/json"
	if (token !== "") h["Authorization"] = "Bearer " + token
	uni.request({
		url: BASE + "/api/subscription/order?userId=1&planId=" + selectedPlanId.value,
		method: "POST",
		header: h,
		success: (): void => { uni.showToast({ title: "订单已创建", icon: "success" }) },
		fail: (): void => {}
	})
}

onShow(() => { loadPlans() })
</script>

<style>
.sp-page {
	flex: 1;
	flex-direction: column;
	background-color: #FFF5EC;
	align-items: center;
}

/* -- hero -- */
.sp-hero {
	align-items: center;
	padding-top: 80rpx;
	padding-bottom: 48rpx;
}
.sp-hero-emoji {
	font-size: 80rpx;
	margin-bottom: 16rpx;
}
.sp-hero-title {
	font-size: 44rpx;
	font-weight: 800;
	color: #3D2C2A;
}
.sp-hero-sub {
	font-size: 26rpx;
	color: #B8A098;
	margin-top: 10rpx;
}

/* -- 套餐 -- */
.sp-plans {
	flex-direction: row;
	padding: 0 28rpx;
	width: 100%;
}
.sp-card {
	flex: 1;
	align-items: center;
	padding: 32rpx 20rpx;
	margin: 0 8rpx;
	background-color: #FFFFFF;
	border-radius: 24rpx;
	border: 2rpx solid #F0E8E2;
	position: relative;
}
.sp-card-on {
	border: 3rpx solid #FF8C42;
	background-color: #FFFBF8;
}
.sp-recommend {
	position: absolute;
	top: -16rpx;
	background-color: #FF8C42;
	padding: 6rpx 24rpx;
	border-radius: 20rpx;
}
.sp-recommend-text {
	font-size: 20rpx;
	color: #FFFFFF;
	font-weight: 700;
}
.sp-name {
	font-size: 28rpx;
	font-weight: 700;
	color: #3D2C2A;
	margin: 12rpx 0 16rpx;
}
.sp-price-row {
	flex-direction: row;
	align-items: flex-end;
	margin-bottom: 4rpx;
}
.sp-price-symbol {
	font-size: 32rpx;
	font-weight: 700;
	color: #FF8C42;
}
.sp-price {
	font-size: 56rpx;
	font-weight: 800;
	color: #FF8C42;
}
.sp-dur {
	font-size: 22rpx;
	color: #B8A098;
	margin-bottom: 20rpx;
}

/* -- 权益 -- */
.sp-features {
	width: 100%;
	align-items: center;
}
.sp-feature {
	flex-direction: row;
	align-items: center;
	margin-bottom: 8rpx;
}
.sp-feature-check {
	font-size: 22rpx;
	color: #7EC8A0;
	font-weight: 700;
	margin-right: 6rpx;
}
.sp-feature-text {
	font-size: 22rpx;
	color: #8C7A70;
}

/* -- 购买按钮 -- */
.sp-buy {
	width: 640rpx;
	margin-top: 48rpx;
	padding: 28rpx 0;
	background-color: #FF8C42;
	border-radius: 48rpx;
	align-items: center;
}
.sp-buy-text {
	font-size: 32rpx;
	color: #FFFFFF;
	font-weight: 700;
}

.sp-footer {
	font-size: 22rpx;
	color: #C8B8B0;
	margin-top: 32rpx;
}
</style>