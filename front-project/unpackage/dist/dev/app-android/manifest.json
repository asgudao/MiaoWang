{
  "id": "__UNI__uniappx",
  "name": "喵汪",
  "description": "面向猫狗主人的宠物护理App",
  "version": {
    "name": "1.0.0",
    "code": "100"
  },
  "uni-app-x": {
    "styleIsolationVersion": "2",
    "compilerVersion": "5.15"
  },
  "app": {
    "distribute": {
      "android": {
        "packageName": "com.miaowang.app",
        "minSdkVersion": 21,
        "targetSdkVersion": 33,
        "abiFilters": [
          "armeabi-v7a",
          "arm64-v8a"
        ]
      },
      "icons": {
        "android": {
          "hdpi": "static/logo.png",
          "xhdpi": "static/logo.png",
          "xxhdpi": "static/logo.png",
          "xxxhdpi": "static/logo.png"
        }
      },
      "splashscreen": {
        "android": {
          "hdpi": "static/logo.png",
          "xhdpi": "static/logo.png",
          "xxhdpi": "static/logo.png"
        },
        "alwaysShowBeforeRender": false,
        "autoclose": true
      }
    }
  }
}