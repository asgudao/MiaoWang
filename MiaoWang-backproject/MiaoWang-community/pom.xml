<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.MapleLeaf.MiaoWang</groupId>
        <artifactId>MiaoWang-backproject</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>MiaoWang-community</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--MyBatis-Plus 3.5.9 起分页插件依赖 jsqlparser，需单独引入，版本与 mybatis-plus 保持一致-->
        <mybatis-plus-jsqlparser.version>3.5.14</mybatis-plus-jsqlparser.version>
        <!--
        视频抽首帧用 jcodec（**纯 Java**，无任何原生库）。
        为什么不选 JavaCV / ffmpeg：javacv-platform 会把各平台 ffmpeg 原生包全拉下来（数百 MB ~ 1GB），
        而本项目只需要"解一帧 H.264 存成 JPEG"这一件事；jcodec + jcodec-javase 合计约 2.5MB，且不装任何系统软件。
        代价与边界见 support/VideoCoverExtractor 的类注释（只覆盖 H.264/MP4 这一档，失败一律降级为无封面）。
        -->
        <jcodec.version>0.2.5</jcodec.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.MapleLeaf.MiaoWang</groupId>
            <artifactId>MiaoWang-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <scope>compile</scope>
        </dependency>
        <!--MinIO 客户端与上传封装由 common 传递引入（版本在父 pom 统一管理），社区不再单独声明-->
        <!--MyBatis-Plus 分页插件（PaginationInnerInterceptor 需要 jsqlparser）-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus-jsqlparser.version}</version>
        </dependency>
        <!--seata 暂时注释：等订阅支付跨服务事务场景时再启用（需要 seata-server 注册到 Nacos + 版本对齐）-->
        <!--
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>
        -->
        <!--视频抽首帧：jcodec 纯 Java 解码 H.264，不引入任何原生库（详见父 properties 里的 jcodec.version 注释）-->
        <dependency>
            <groupId>org.jcodec</groupId>
            <artifactId>jcodec</artifactId>
            <version>${jcodec.version}</version>
        </dependency>
        <!--jcodec-javase 提供 AWTUtil.toBufferedImage：把解码出的 Picture 转成 BufferedImage 才能写 JPEG-->
        <dependency>
            <groupId>org.jcodec</groupId>
            <artifactId>jcodec-javase</artifactId>
            <version>${jcodec.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!--nacos配置中心客户端-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!--seate的undo_log 默认的序列化方式 jackson，在seata中使用jackson序列化方式会有问题，kryo序列化方式就可以解决这个问题（随 seata 一起启用）-->
        <!--
        <dependency>
            <groupId>de.javakaffee</groupId>
            <artifactId>kryo-serializers</artifactId>
        </dependency>
        -->
    </dependencies>
    <!--添加maven插件，项目的打包工具，打成jar包，否则在打包运行时报错   -->
    <build>
        <plugins>
            <!--springboot插件，把项目打包jar，通过java -jar的命令运行项目，就可启动web项目-->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>