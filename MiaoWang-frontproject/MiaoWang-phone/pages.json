{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "喵汪"
			}
		},
		{
			"path": "pages/community/community",
			"style": {
				"navigationBarTitleText": "社区",
				// 社区信息流是页码分页 → 需要下拉刷新与触底加载
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 100
			}
		},
		{
			"path": "pages/community/detail",
			"style": {
				"navigationBarTitleText": "帖子详情",
				"onReachBottomDistance": 100
			}
		},
		{
			// 社区搜索：入口是社区页顶部那个"搜索帖子"框（**是真入口，不是死按钮**）。
			// 用 GET /community/post/search（**游标分页**：lastId 原样回传 nextCursor）→ 下拉刷新 + 触底加载。
			// ⚠️ 关键词为空/超长后端直接 B000327 → 这一页空关键词**不发请求**，页内给真实提示。
			"path": "pages/community/search",
			"style": {
				"navigationBarTitleText": "搜索帖子",
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 100
			}
		},
		{
			// 用户主页：入口是社区里点作者名（?uid=），uid 只能从社区 DTO / 页面参数来
			"path": "pages/user/profile",
			"style": {
				"navigationBarTitleText": "用户主页",
				// 帖子 / 点赞两个分段是游标分页 → 下拉刷新 + 触底加载
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 100
			}
		},
		{
			"path": "pages/pets/pets",
			"style": {
				"navigationBarTitleText": "萌宠"
			}
		},
		{
			"path": "pages/knowledge/knowledge",
			"style": {
				"navigationBarTitleText": "知识库",
				// 知识碎片列表是页码分页 → 需要下拉刷新与触底加载
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 100
			}
		},
		{
			"path": "pages/knowledge/detail",
			"style": {
				"navigationBarTitleText": "知识详情"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/register/register",
			"style": {
				"navigationBarTitleText": "注册"
			}
		},
		{
			"path": "pages/pet-detail/pet-detail",
			"style": {
				"navigationBarTitleText": "宠物档案"
			}
		},
		{
			"path": "pages/pet-edit/pet-edit",
			"style": {
				"navigationBarTitleText": "编辑宠物"
			}
		},
		{
			"path": "pages/ai/ai",
			"style": {
				"navigationBarTitleText": "AI 问诊"
			}
		},
		{
			// 宠物对话：非 tab 页，全局 navigationStyle=custom → 页面自绘返回栏（与 pages/ai/ai 同一套写法）。
			// 走 miaowang-ai-pet（**不是** ai-knowledge）：档 1 = 非流式一问一答 + 宠物人设 + 会话历史；
			// 空态会调 POST /ai/pet/greet（**不扣聊天次数**）。入口是首页那张对话卡 + 页内「去和它说话」。
			"path": "pages/ai/pet",
			"style": {
				"navigationBarTitleText": "宠物对话"
			}
		},
		{
			"path": "pages/vip/vip",
			"style": {
				"navigationBarTitleText": "喵汪会员"
			}
		},
		{
			"path": "pages/health/health",
			"style": {
				"navigationBarTitleText": "健康档案"
			}
		},
		{
			"path": "pages/health/weight",
			"style": {
				"navigationBarTitleText": "体重曲线"
			}
		},
		{
			"path": "pages/health/preventive",
			"style": {
				"navigationBarTitleText": "疫苗与驱虫"
			}
		},
		{
			"path": "pages/health/medical",
			"style": {
				"navigationBarTitleText": "就诊与病史"
			}
		},
		{
			"path": "pages/health/medication",
			"style": {
				"navigationBarTitleText": "用药"
			}
		},
		{
			"path": "pages/health/allergy",
			"style": {
				"navigationBarTitleText": "过敏史"
			}
		},
		{
			"path": "pages/health/symptom",
			"style": {
				"navigationBarTitleText": "症状日记"
			}
		},
		{
			"path": "pages/health/timeline",
			"style": {
				"navigationBarTitleText": "健康时间线"
			}
		},
		{
			"path": "pages/health/record-edit",
			"style": {
				"navigationBarTitleText": "健康记录"
			}
		},
		{
			// 消息通知：入口在「我的」页的「消息通知」一行（tab 入口红点由 mine.vue 的 onShow 拉 unread-count）
			"path": "pages/notification/list",
			"style": {
				"navigationBarTitleText": "消息通知",
				// 通知列表是游标分页 → 下拉刷新 + 触底加载
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 100
			}
		},
		{
			// 个人资料：入口在「我的」页的「个人资料」一行；
			// 能改的只有显示名称 / 宠物称呼 / 邮箱（PUT /user），头像走 POST /user/avatar；
			// 手机号与用户名在页内说明为只读（换绑要短信验证码，本页未接）。纯读改写，无分页 → 不挂下拉刷新。
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "个人资料"
			}
		},
		{
			// 关于喵汪：入口在「我的」页的「关于喵汪」一行。纯静态页，零网络请求。
			"path": "pages/about/about",
			"style": {
				"navigationBarTitleText": "关于喵汪"
			}
		},
		{
			// 提醒设置：入口在「我的」页的「提醒设置」一行（自绘导航，页内 onShow 重算，无分页 → 不挂下拉刷新）。
			// ⚠️ 这是**本地提醒**的口径（settings 存本地 + 到点由本地通知触发），不是服务端推送：
			// 全仓库没有推送设施，页面里也如实写明了这一点。
			"path": "pages/remind/setting",
			"style": {
				"navigationBarTitleText": "提醒设置"
			}
		}
	],
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "喵汪",
		"navigationBarBackgroundColor": "#F7F2EE",
		"backgroundColor": "#F7F2EE",
		"backgroundColorTop": "#1A1310",
		"backgroundColorBottom": "#F7F2EE"
	},
	"tabBar": {
		"color": "#8A7767",
		"selectedColor": "#C2410C",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
